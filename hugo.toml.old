baseURL = "https://laurence-poussard.com/"
theme = "PaperMod"
defaultContentLanguage = "fr"
defaultContentLanguageInSubdir = false
enableRobotsTXT = true
buildDrafts = false
buildFuture = false

[outputs]
  home = ["HTML", "RSS", "JSON"]

[markup]
  [markup.goldmark]
    [markup.goldmark.renderer]
      unsafe = true

# ══════════════════════════════════════════
# TAXONOMIES
# tag   = maillage fin transversal
# category = les rubriques de la home (IA / Architecture / Reflexion)
# ══════════════════════════════════════════

[taxonomies]
  tag = "tags"
  category = "categories"

# ══════════════════════════════════════════
# PARAMÈTRES GLOBAUX
# ══════════════════════════════════════════

[params]
  author = "Laurence Poussard"
  defaultTheme = "auto"
  mainSections = ["articles"]
  ShowReadingTime = true
  ShowShareButtons = true
  ShareButtons = ["linkedin", "whatsapp"]
  ShowPostNavLinks = true
  ShowBreadCrumbs = true
  ShowCodeCopyButtons = true
  ShowToc = true
  TocOpen = false
  ShowLanguageSwitcher = true
  comments = true

  [[params.socialIcons]]
    name = "linkedin"
    url = "https://www.linkedin.com/in/laurence-poussard-76115162/"
  [[params.socialIcons]]
    name = "email"
    url = "mailto:laurence.poussard63@gmail.com"

  [params.giscus]
    repo = "Djeckelle/MonBlog"
    repoID = "R_kgDOSXBQ6g"
    category = "General"
    categoryID = "DIC_kwDOSXBQ6s4C-3zj"
    mapping = "pathname"
    strict = "0"
    reactionsEnabled = "1"
    emitMetadata = "0"
    inputPosition = "top"
    theme = "preferred_color_scheme"
    lang = "fr"

# ══════════════════════════════════════════
# FRANÇAIS (langue par défaut)
# ══════════════════════════════════════════

[languages.fr]
  locale = "fr-FR"
  label = "Français"
  weight = 1
  title = "Laurence Poussard"

  [languages.fr.params]
    description = "Architecture d'entreprise, IA, gouvernance du SI — convictions, manifestes et partage d'expérience."

  [languages.fr.params.homeInfoParams]
    Title = "Laurence Poussard"
    Content = """
Architecte d'entreprise. Experte de la *Continuous Architecture*.

Ce site est un espace de partage d'expériences, d'intuitions et de retours du terrain pour **insuffler du sens, élever le débat et nourrir l'intelligence collective** autour de nos choix technologiques.

---

### 🚀 Par où commencer ?

• **[Le Manifeste](/manifeste/)** — *Les 6 habitudes d'un SI efficace (pour un SI au service du métier, du collectif et du temps long)*  
• **[Réflexions & Livre](/bibliotheque/)** — *Les dossiers de fond sur la gouvernance de l'IA, la souveraineté et la complexité (VUCA)*  
• **[Convictions & Dialogues](/intentions/)** — *Pourquoi ce partage, et comment faire circuler et grandir ces idées ensemble dans vos collectifs*  
• **[Articles](/articles/)** — *Les analyses et billets du fil de l'eau*
"""

  [[languages.fr.menu.main]]
    identifier = "manifeste"
    name = "Manifeste"
    url = "/manifeste/"
    weight = 10

  [[languages.fr.menu.main]]
    identifier = "bibliotheque"
    name = "Réflexions & Livre"
    url = "/bibliotheque/"
    weight = 20

  [[languages.fr.menu.main]]
    identifier = "articles"
    name = "Articles"
    url = "/articles/"
    weight = 30

  [[languages.fr.menu.main]]
    identifier = "intentions"
    name = "Convictions & Dialogues"
    url = "/intentions/"
    weight = 40

  [[languages.fr.menu.main]]
    identifier = "about"
    name = "À propos"
    url = "/about/"
    weight = 50

# ══════════════════════════════════════════
# ANGLAIS
# ══════════════════════════════════════════

[languages.en]
  locale = "en-US"
  label = "English"
  weight = 2
  title = "Laurence Poussard"

  [languages.en.params]
    description = "Enterprise architecture, AI, IS governance — analysis, manifestos and collective intelligence."

  [languages.en.params.homeInfoParams]
    Title = "Laurence Poussard"
    Content = """
Enterprise Architect. Continuous Architecture practitioner.

This site is a space for sharing field experience, insights, and lessons learned—aiming to **bring meaning, elevate the debate, and foster collective intelligence** around technological choices.

---

### 🚀 Where to start?

• **[The Manifesto](/en/manifesto/)** — *6 habits for an effective IS (serving business, people, and the long term)*  
• **[Insights & Book](/en/library/)** — *Deep dives into AI governance, sovereignty, and complexity (VUCA)*  
• **[Convictions & Dialogue](/en/intentions/)** — *The vision behind this site and how to exchange ideas together*  
• **[Articles](/en/articles/)** — *Ongoing analyses and posts*
"""

  [[languages.en.menu.main]]
    identifier = "manifesto"
    name = "Manifesto"
    url = "/en/manifesto/"
    weight = 10

  [[languages.en.menu.main]]
    identifier = "library"
    name = "Insights & Book"
    url = "/en/library/"
    weight = 20

  [[languages.en.menu.main]]
    identifier = "articles"
    name = "Articles"
    url = "/en/articles/"
    weight = 30

  [[languages.en.menu.main]]
    identifier = "intentions"
    name = "Convictions & Dialogue"
    url = "/en/intentions/"
    weight = 40

  [[languages.en.menu.main]]
    identifier = "about"
    name = "About"
    url = "/en/about/"
    weight = 50